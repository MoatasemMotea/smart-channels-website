##############################################################################
# Smart Channels — environment configuration
#
# Copy to `.env.local` for development, or set these in your hosting
# provider's dashboard for production.
#
#   cp .env.example .env.local
#
# NEVER commit `.env.local` or any file containing real secrets. `.gitignore`
# already excludes them.
#
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle and are
# readable by anyone. Everything else stays on the server. Never put a secret
# behind a NEXT_PUBLIC_ prefix.
##############################################################################


# -----------------------------------------------------------------------------
# SITE URL  — required for production
# -----------------------------------------------------------------------------
# The canonical origin, with no trailing slash.
#
# This one variable drives canonical URLs, hreflang alternates, the sitemap,
# robots.txt and Open Graph image URLs.
#
# IMPORTANT: until this is set, the site serves `noindex, nofollow` and a
# robots.txt that disallows everything. That is deliberate — it stops a preview
# deployment being indexed on a temporary URL and competing with the real site.
# Setting it is the single switch that makes the site publicly indexable, so it
# must be set on the production deployment and left unset elsewhere.
#
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as a fallback automatically.
NEXT_PUBLIC_SITE_URL=https://smartchannels.co


# -----------------------------------------------------------------------------
# CONTACT FORM  — required for the form to deliver
# -----------------------------------------------------------------------------
# Resend API key. Create one at https://resend.com/api-keys
#
# Without this the contact form returns an honest error to the visitor and logs
# a loud message server-side. It never silently discards an enquiry.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in the Resend dashboard —
# sending from an unverified domain fails SPF/DKIM and lands in spam.
# Format: "Display Name <address@domain>"
CONTACT_FROM_EMAIL=Smart Channels Website <website@smartchannels.co>

# Where enquiries are delivered. Defaults to info@smartchannels.co if unset.
CONTACT_TO_EMAIL=info@smartchannels.co


# -----------------------------------------------------------------------------
# ANALYTICS  — optional
# -----------------------------------------------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
#
# Leave empty and no analytics code is served at all — no tag, no cookie, no
# request. When set, it is configured with IP anonymisation and with Google
# Signals and ad personalisation disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (the content value only,
# not the full meta tag). Only needed if verifying by HTML tag rather than DNS.
NEXT_PUBLIC_GSC_VERIFICATION=


# -----------------------------------------------------------------------------
# OPTIONAL BEHAVIOUR
# -----------------------------------------------------------------------------
# Google Maps embed URL. Left unset by default and deliberately so: a Maps
# iframe costs roughly 800 KB across dozens of requests and sets third-party
# cookies. With it unset, the contact section shows a branded location card
# linking out to Google Maps instead. Set it only if an embedded map is wanted.
#
# To obtain one: open the location in Google Maps → Share → Embed a map → copy
# the `src` value from the generated iframe.
NEXT_PUBLIC_MAP_EMBED_URL=

# Force the "content pending" placeholders for Projects, Gallery, Partners,
# Clients and Certifications on or off.
#   true  — always show them (useful for reviewing a preview deployment)
#   false — never show them
#   unset — shown in development, hidden in production (the default)
NEXT_PUBLIC_SHOW_PENDING_SECTIONS=
