{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Smart Channels gallery manifest",
  "type": "object",
  "required": ["status", "items"],
  "properties": {
    "_readme": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["published", "pending"] },
    "pendingNote": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "image", "category", "technology", "caption", "featured", "sortOrder", "published"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "image": {
            "type": "object",
            "required": ["src", "width", "height", "alt"],
            "additionalProperties": false,
            "properties": {
              "src": { "type": "string", "pattern": "^/images/gallery/" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "alt": { "$ref": "#/$defs/localized" },
              "blurDataURL": { "type": "string" }
            }
          },
          "project": { "type": "string" },
          "category": {
            "enum": ["infrastructure", "networks", "security", "audio-visual", "communications", "end-user-computing", "specialised-systems"]
          },
          "industry": { "type": "string" },
          "technology": {
            "type": "array",
            "items": {
              "enum": ["structured-cabling", "fibre-optics", "wireless", "surveillance", "access-control", "servers", "storage-backup", "firewall", "unified-communications", "display-systems", "point-of-sale", "printing"]
            }
          },
          "location": { "$ref": "#/$defs/localized" },
          "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2}){0,2}$" },
          "caption": { "$ref": "#/$defs/localized" },
          "featured": { "type": "boolean" },
          "sortOrder": { "type": "integer" },
          "published": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["en", "ar"],
      "additionalProperties": false,
      "properties": { "en": { "type": "string" }, "ar": { "type": "string" } }
    }
  }
}
