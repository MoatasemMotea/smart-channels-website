# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# Generated by Next.js for AI agents (next.config: agentRules)
AGENTS.md
CLAUDE.md

# Company Profile PDFs are internal source material and must never ship — see
# L-41 in docs/design-decisions.md. This blocks any PDF under public/, not just
# the profile, because the failure is the same either way: a document reaching
# the public directory is a document on the public site.
public/**/*.pdf
